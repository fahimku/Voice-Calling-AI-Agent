# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Safe for the browser. Named ANON_KEY to match the app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# mock places no real calls. Set to live to call the Vapi REST API.
VOICE_PROVIDER_MODE=mock

# Vapi secret key. Server-only. Required when VOICE_PROVIDER_MODE=live.
VAPI_API_KEY=

# Bearer token from the Vapi server credential. Server-only.
VAPI_WEBHOOK_SECRET=

# Shared secret for the scheduler cron header. Server-only.
CRON_SECRET=

# Google service account that can edit connected sheets. Server-only. Never log the private key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key. Literal \n sequences are turned into newlines. Keep the value in quotes.
GOOGLE_PRIVATE_KEY=

# Public site URL used for the call link written to Google Sheets. Example: http://localhost:3000
NEXT_PUBLIC_APP_URL=
