# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Safe for the browser. Named ANON_KEY to match the app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Vapi secret key. Server-only. Used in a later phase.
VAPI_API_KEY=

# Shared secret Vapi sends on webhooks. Server-only. Used in a later phase.
VAPI_WEBHOOK_SECRET=

# Shared secret for the scheduler cron header. Server-only. Used in a later phase.
CRON_SECRET=
